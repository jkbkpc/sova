{
  "name": "sova",
  "version": "1.3.13",
  "description": "Ľahký prehliadač s uspávaním kariet a blokovaním reklám",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build-adblock": "node scripts/build-adblock.js",
    "dist": "npm run build-adblock && electron-builder --win portable nsis",
    "release": "npm run build-adblock && electron-builder --win portable nsis --publish always",
    "ship": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "author": "Jakub",
  "license": "MIT",
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "^6.8.11",
    "tldts-experimental": "^7.4.16"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Sova",
  "build": {
    "appId": "sk.lunys.sova",
    "productName": "Sova",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "adblock-*.bin"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Sova-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Sova-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jkbkpc",
        "repo": "sova",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "sk",
      "cs",
      "en-US"
    ]
  }
}
